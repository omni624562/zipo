// 執行檔圖示：索引 0 為程式圖示，索引 1 為壓縮檔圖示（檔案總管中壓縮檔使用）
1 ICON "ziptool.ico"
2 ICON "archive.ico"

1 VERSIONINFO
FILEVERSION 0,4,10,0
PRODUCTVERSION 0,4,10,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040404B0"
    BEGIN
      VALUE "FileDescription", "Zipo"
      VALUE "ProductName", "Zipo"
      VALUE "OriginalFilename", "zipo-gui.exe"
      VALUE "FileVersion", "0.4.10"
      VALUE "ProductVersion", "0.4.10"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0404, 1200
  END
END
